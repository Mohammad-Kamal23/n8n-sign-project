# Copy to .env and fill in. .env is ignored by git.

# PostgreSQL (used by the n8n workflow's Postgres node for the audit log)
POSTGRES_USER=signing
POSTGRES_PASSWORD=change-me
POSTGRES_DB=signing_db
TIMEZONE=Asia/Amman

# Stamping API (backend/main.py)
# Your stamp image inside backend/ (never committed); a sample stamp is used when it is missing
STAMP_PATH=stamp.png
# Size of the stamp on the page, in PDF points
STAMP_WIDTH=90
STAMP_HEIGHT=45
# Template match score needed to accept a zone (0-1)
MATCH_THRESHOLD=0.8
# 0 = template matching only (no model download, CPU friendly)
USE_FLORENCE=1
FLORENCE_MODEL=microsoft/Florence-2-base-ft
FLORENCE_PROMPT=signature line or blank space for stamp
# The API only processes files below INPUT_ROOT and writes results to OUTBOX_PATH
INPUT_ROOT=/home/node/simulated_cloud
OUTBOX_PATH=/home/node/simulated_cloud/03_outbox
